# ─────────────────────────────────────────────────────────────
#  REQUIRED
# ─────────────────────────────────────────────────────────────

# Signs session cookies. The app refuses to start in production without it.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL of the app. Must match the address you open in the browser,
# otherwise session cookies are rejected and login silently fails.
# Use https:// in production — the session cookie is sent over this scheme.
BETTER_AUTH_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# SQLite database file. Created automatically on first start;
# the schema and all migrations run at boot, there is no migrate command.
DB_PATH=./ozon.db

# Directory for uploaded price spreadsheets.
UPLOAD_DIR=./uploads

# Comma-separated list of origins allowed to send authenticated requests.
# Defaults to BETTER_AUTH_URL. Never set this to "*" — cookies travel with it.
TRUSTED_ORIGINS=

# Set to 1 only if your host's DNS cannot resolve marketplace API domains.
# Routes all DNS lookups through 8.8.8.8 / 1.1.1.1.
FORCE_PUBLIC_DNS=0

# ─────────────────────────────────────────────────────────────
#  FIRST ADMIN  (used once by `npm run seed`)
# ─────────────────────────────────────────────────────────────

ADMIN_EMAIL=admin@example.com
# Minimum 12 characters. Required — seeding aborts if unset.
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ─────────────────────────────────────────────────────────────
#  EXTERNAL API for LLM agents  (see docs/en/api-external.md)
# ─────────────────────────────────────────────────────────────

# Bearer master key. EMPTY = external API disabled (endpoints return 503).
# Generate: openssl rand -hex 32
EXTERNAL_API_KEY=
# Comma-separated IP allowlist. Strongly recommended whenever the port is
# reachable from the internet — an empty value accepts any source IP.
EXTERNAL_API_ALLOWED_IPS=
# Requests per minute per IP.
EXTERNAL_API_RATE_PER_MIN=120

# ─────────────────────────────────────────────────────────────
#  OPTIONAL — S3-compatible backups  (empty = disabled)
# ─────────────────────────────────────────────────────────────

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=repricer/
BACKUP_RETAIN=7
BACKUP_HOUR=3

# ─────────────────────────────────────────────────────────────
#  OPTIONAL — Sentry  (empty = disabled)
# ─────────────────────────────────────────────────────────────

SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=development

# Frontend Sentry is compiled into the bundle at BUILD time, not runtime.
# Locally it is read from VITE_SENTRY_DSN; in Docker it is passed as the
# build arg SENTRY_DSN_FRONTEND (see Dockerfile).
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────
#  DEV ONLY
# ─────────────────────────────────────────────────────────────

# Backend the Vite dev server proxies /api to.
VITE_API_TARGET=http://localhost:3001
